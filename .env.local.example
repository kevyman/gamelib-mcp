# Copy this file to `.env` for local Docker testing.

# Core runtime
DATABASE_URL=file:/data/gamelib.db
PORT=8000
LOG_LEVEL=INFO   # DEBUG surfaces per-item enrichment failures; INFO is the production default
# Localhost-only development explicitly disables interactive OAuth. Never use
# this mode on an internet-facing deployment. Admin HTTP routes remain protected.
MCP_AUTH_MODE=disabled
MCP_ADMIN_AUTH_TOKEN=local-admin-token-change-me-32-chars
# Browser origins allowed on the HTTP surface. Required for the
# create_session_ingest_link paste form, whose POST sends this Origin; harmless
# otherwise. In oauth mode MCP_PUBLIC_BASE_URL's origin is auto-allowlisted.
MCP_ALLOWED_ORIGINS=http://localhost:8000

# Steam-specific sync and review integration
STEAM_API_KEY=
STEAM_ID=
STEAM_PROFILE_ID=

# Optional integrations
BACKLOGGD_USER=
PSN_NPSSO=
OPENXBL_API_KEY=                                             # Xbox ownership+playtime via xbl.io; https://xbl.io/console
OPENXBL_XUID=                                                # optional; defaults to the API key owner's own account
NINTENDO_COOKIES_FILE=/data/nintendo_cookies.json          # Switch ownership; populate via create_session_ingest_link(provider="nintendo")
NINTENDO_PCTL_SESSION_FILE=/data/nintendo_pctl_session.json  # Switch playtime; populate via create_session_ingest_link(provider="nintendo_pctl")
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
ITAD_API_KEY=
ITAD_COUNTRY=US

# Optional cookie files for import_purchases; populated only through the
# create_session_ingest_link browser paste form (cookies never enter the chat).
#EPIC_COOKIES_FILE=/data/epic_cookies.json                   # Epic purchase history (prices); create_session_ingest_link(provider="epic")
#HUMBLE_COOKIES_FILE=/data/humble_cookies.json               # Humble purchase history; create_session_ingest_link(provider="humble")
#STEAM_REFRESH_TOKEN_FILE=/data/steam_refresh_token.json     # PREFERRED Steam session: long-lived steamRefresh_steam token; create_session_ingest_link(provider="steam_refresh")
#STEAM_STORE_COOKIES_FILE=/data/steam_store_cookies.json     # legacy Steam fallback (short-lived cookies); create_session_ingest_link(provider="steam_store")

# Optional host-mounted config paths used by docker-compose.yml
EPIC_LEGENDARY_HOST_PATH=./data/legendary
LGOGDOWNLOADER_HOST_PATH=./data/lgogdownloader
