# Copy this file to `.env` for local Docker testing.

# Core runtime
DATABASE_URL=file:/data/gamelib.db
PORT=8000
# Localhost-only development explicitly disables interactive OAuth. Never use
# this mode on an internet-facing deployment. Admin HTTP routes remain protected.
MCP_AUTH_MODE=disabled
MCP_ADMIN_AUTH_TOKEN=local-admin-token-change-me-32-chars

# Steam-specific sync and review integration
STEAM_API_KEY=
STEAM_ID=
STEAM_PROFILE_ID=

# Optional integrations
BACKLOGGD_USER=
PSN_NPSSO=
NINTENDO_COOKIES_FILE=/data/nintendo_cookies.json          # Switch ownership; populate via set_nintendo_session
NINTENDO_PCTL_SESSION_FILE=/data/nintendo_pctl_session.json  # Switch playtime; populate via set_nintendo_pctl_session
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Optional host-mounted config paths used by docker-compose.yml
EPIC_LEGENDARY_HOST_PATH=./data/legendary
LGOGDOWNLOADER_HOST_PATH=./data/lgogdownloader
