DATABASE_URL=file:/data/gamelib.db
MCP_AUTH_MODE=oauth
# Public HTTPS origin: the OAuth flow advertises it and Caddy serves it as its site address.
MCP_PUBLIC_BASE_URL=https://gamelib.example.com
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
MCP_OAUTH_JWT_SIGNING_KEY=change-me-generate-with-openssl-rand-hex-32
# Numeric GitHub user id(s), comma-separated: https://api.github.com/users/<login> shows "id".
# Ids, never usernames: a username can be renamed and re-registered by someone else; an id never moves.
MCP_OAUTH_GITHUB_USER_IDS=
MCP_ADMIN_AUTH_TOKEN=change-me-generate-with-openssl-rand-hex-32
# Keep FastMCP's encrypted OAuth registrations/tokens on the persistent /data mount.
FASTMCP_HOME=/data/fastmcp
# Browser-origin MCP clients must be allowlisted. Native/CLI clients that send no Origin header are unaffected.
MCP_ALLOWED_ORIGINS=https://claude.ai,https://chatgpt.com
PORT=8000
# Root log level (DEBUG/INFO/WARNING/ERROR). DEBUG surfaces per-item enrichment failures.
LOG_LEVEL=INFO
# How often the background library refresh runs, in hours (default 24; unset or
# unparseable also means 24). Zero or negative disables the periodic loop, which
# also silences the wishlist deal alerts below — they ride on each refresh.
LIBRARY_REFRESH_INTERVAL_HOURS=24
# Control plane inspects both values. Missing either keeps Steam unconfigured/readiness red.
STEAM_API_KEY=your-key-from-steamcommunity.com/dev/apikey
STEAM_ID=your-64bit-steamid
# IGDB (Twitch) credentials — for game identity resolution and metadata enrichment
# Get from https://dev.twitch.tv/console (create an application, category = Website Integration)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
STEAM_PROFILE_ID=your-steam-community-profile-id
BACKLOGGD_USER=your-backloggd-username
# Control plane inspects the mounted Legendary dir for `user.json` and `metadata/*.json`.
# Missing either leaves Epic unconfigured/partial; stale auth from startup sync shows as degraded.
# host path to legendary config dir; defaults to ./data/legendary
EPIC_LEGENDARY_HOST_PATH=
# Control plane inspects this mount and whether `lgogdownloader` exists in PATH inside the container.
# host path to lgogdownloader config dir; defaults to ./data/lgogdownloader
LGOGDOWNLOADER_HOST_PATH=
# Control plane inspects this cookie file for Nintendo ownership VGCS readiness.
# populate via create_session_ingest_link(provider="nintendo"); no secret values are echoed back
NINTENDO_COOKIES_FILE=data/nintendo_cookies.json
# Parental Controls session token for Switch *playtime* (plain OAuth — no f-token). Captures games
# played on a registered console regardless of which account owns them. Control plane inspects this
# file for playtime readiness; populate via create_session_ingest_link(provider="nintendo_pctl").
# create_session_ingest_link(provider="nintendo_pctl") populates this; no secret values are echoed back
NINTENDO_PCTL_SESSION_FILE=data/nintendo_pctl_session.json
# Xbox has no purchase-library API; ownership comes from OpenXBL title history ("played on this
# account"). Control plane inspects whether an OpenXBL key is configured.
# optional; defaults to the API key owner's own account
OPENXBL_XUID=
# Optional token/cookie files for import_purchases and the PSN/Xbox syncs. Each is populated only
# through the create_session_ingest_link browser paste form; set these to move the files off the defaults.
# NPSSO token via create_session_ingest_link(provider="psn"); bare PSN_NPSSO in the env still works as a legacy fallback
#PSN_NPSSO_FILE=data/psn_npsso.json
# OpenXBL API key from https://xbl.io/console via create_session_ingest_link(provider="xbox"); bare OPENXBL_API_KEY in the env still works as a legacy fallback
#OPENXBL_API_KEY_FILE=data/openxbl_api_key.json
# www.epicgames.com cookies via create_session_ingest_link(provider="epic") — purchase prices; Legendary handles ownership
#EPIC_COOKIES_FILE=data/epic_cookies.json
# humblebundle.com cookies via create_session_ingest_link(provider="humble")
#HUMBLE_COOKIES_FILE=data/humble_cookies.json
# PREFERRED: long-lived steamRefresh_steam token from login.steampowered.com via create_session_ingest_link(provider="steam_refresh"); mints store cookies on demand
#STEAM_REFRESH_TOKEN_FILE=data/steam_refresh_token.json
# legacy fallback: short-lived store.steampowered.com cookies via create_session_ingest_link(provider="steam_store")
#STEAM_STORE_COOKIES_FILE=data/steam_store_cookies.json
# Nintendo has no wishlist API; sync(targets=["wishlist"]) scrapes a DekuDeals shared wishlist's public ".json" export instead.
# e.g. https://www.dekudeals.com/wishlist/your-share-id
DEKUDEALS_WISHLIST_URL=
# Price lookups for wishlist deals (get_wishlist(with_prices=True))
# free key from isthereanydeal.com/apps/my/ — enables Steam/GOG/Epic price lookups
ITAD_API_KEY=
# ISO country code for pricing (optional; default US)
ITAD_COUNTRY=US
# Discord or Slack incoming-webhook URL for wishlist deal alerts. Leave empty to disable.
# Alerts fire at the end of each library refresh — so once every
# LIBRARY_REFRESH_INTERVAL_HOURS (24h by default) — once per new event: a price reaching a recorded
# verdict's target_price, or an all-time low with an active discount.
DEAL_ALERT_WEBHOOK_URL=

# Hardware preference for discover_games' suggested_platform (comma-separated, highest priority first)
# Stored in the meta table via: INSERT OR REPLACE INTO meta VALUES ('hardware_preference', '["switch2","steam_deck","ps5"]')
HARDWARE_PREFERENCE=switch2,steam_deck,ps5

# Scrape-config healing gate. Unset/0 (default): a manage_scrape_config(action="propose")
# override that passes validation activates immediately. Set to 1 to land proposals as
# 'pending' instead, requiring an explicit manage_scrape_config(action="approve") call.
SCRAPE_HEAL_REQUIRE_APPROVAL=
