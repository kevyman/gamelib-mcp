# The site address is the public origin the app already requires
# (MCP_PUBLIC_BASE_URL, e.g. https://gamelib.example.com); docker-compose.yml
# passes it through from .env, so Caddy and the OAuth metadata cannot drift.
{$MCP_PUBLIC_BASE_URL} {
    redir /stacks /stacks/ 308
    handle_path /stacks/* {
        root * /srv/stacks
        encode zstd gzip
        file_server
    }
    handle {
        reverse_proxy app:8000
    }
}

# Add future MCPs here, e.g.:
# notes.example.com {
#     reverse_proxy notes-mcp:8001
# }
