gamelibmcp.johnwilkos.com {
    redir /stacks /stacks/ 308
    handle_path /stacks/* {
        root * /srv/stacks
        encode zstd gzip
        file_server
    }
    handle {
        reverse_proxy app:8000
    }
}

# The Stacks — 3D library visualization (static site, no auth).
