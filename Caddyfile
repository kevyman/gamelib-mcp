# The site address comes from MCP_DOMAIN in .env (docker-compose.yml passes it
# through and refuses to start Caddy when it is unset).
{$MCP_DOMAIN} {
    redir /stacks /stacks/ 308
    handle_path /stacks/* {
        root * /srv/stacks
        encode zstd gzip
        file_server
    }
    handle {
        reverse_proxy app:8000
    }
}

# Add future MCPs here, e.g.:
# notes.example.com {
#     reverse_proxy notes-mcp:8001
# }
